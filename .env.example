# ===========================================================================
# Regulatory Agent V2 — Exemple de configuration (.env)
# Copier ce fichier vers .env et adapter les valeurs. Ne jamais committer .env.
# ===========================================================================

# --- Mode d'exécution ---
# `false` OBLIGATOIRE en production (logs verbeux, docs exposables,
# tracebacks fournis). `true` uniquement en poste de développement.
DEBUG=false

# --- API ---
# Clé API partagée exigée dans l'en-tête X-API-Key sur tous les endpoints
# sauf /health et l'interface web. DOIT être définie (fail-closed sinon).
# Génération : python3 -c "import secrets; print('API_KEY=' + secrets.token_urlsafe(32))"
API_KEY=remplacez-par-une-cle-longue-et-aleatoire
# Adresse d'écoute. 0.0.0.0 uniquement derrière un proxy TLS.
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1
# Origines navigateur autorisées (séparées par des virgules).
# Un navigateur envoie `Origin: http(s)://host:port` (avec port) — chaque
# combinaison hôte:port doit être listée explicitement, la comparaison est
# exacte. En prod : restreindre au(x) vrai(s) domaine(s).
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8000,http://127.0.0.1:8000
# Exposer /docs et /redoc (Swagger) : true/false
EXPOSER_DOCS=false
# Taille max du corps de requête en octets (2 Mo)
TAILLE_MAX_REQUETE_OCTETS=2097152

# --- Rate limiting (par IP) ---
RATE_LIMIT_MAX_REQUETES=30
RATE_LIMIT_FENETRE_SECONDES=60

# --- Embedding ---
# Modèle d'embedding des requêtes/chunks. DOIT produire la même dimension
# que la collection Qdrant (EMBEDDING_DIMENSION == QDRANT_VECTEUR_TAILLE),
# sinon toute recherche échoue silencieusement (0 evidence, réponses non
# ancrées). Le boot refuse un écart de dimension.
#
# `sentence-transformers/BAAI/bge-m3` : backend sentence-transformers,
#   1024-dim, stable. Recommandé. Tourne sur CPU/MPS (~quelques 100 ms
#   par requête). Voie retenue car :
#   - le repo HF `BAAI/bge-m3` n'a pas de safetensors (KO pour mlx_embeddings) ;
#   - la voie MLX native (`models/bge-m3-mlx`) crashe `Stream(gpu, N)` sur
#     certaines versions de mlx.
MODELE_EMBEDDING=sentence-transformers/BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# --- Qdrant ---
QDRANT_HOST=192.168.1.11
QDRANT_PORT=6333
QDRANT_HTTPS=false
QDRANT_API_KEY=
# Taille des vecteurs de la collection — doit égaler EMBEDDING_DIMENSION.
QDRANT_VECTEUR_TAILLE=1024

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- PostgreSQL (audit, Mac C) — jamais de mot de passe en dur dans le code ---
POSTGRES_DSN=

# --- Mode orchestrateur : real ou mock ---
# ORCHESTRATEUR_MODE=real

# --- Watcher ---
# WATCHER_INTERVALLE_HEURES=6
# WATCHER_FOLLOW_REDIRECTS=false
# Désactiver quand le Watcher tourne dans un process séparé (gunicorn
# multi-worker, systemd unit dédiée) pour éviter les cycles concurrents.
# WATCHER_ACTIF=true
# Délai (s) après le boot avant le premier cycle — laisse /health répondre.
# WATCHER_DELAI_DEMARRAGE_SECONDES=30

# --- Audit ---
# AUDIT_LOCAL_PATH=data/audit.jsonl
