# ===========================================================================
# Regulatory Agent V2 — Exemple de configuration (.env)
# Copier ce fichier vers .env et adapter les valeurs. Ne jamais committer .env.
# ===========================================================================

# --- Mode d'exécution ---
# ENVIRONNEMENT=prod DURCIT le démarrage : refuse DEBUG=true,
# EXPOSER_DOCS=true, une clé absente/placeholder/<32 car., et un bind
# 0.0.0.0 sans TRUSTED_PROXIES. La validation s'applique aussi bien sous
# `python3 main.py` que sous `gunicorn main:app` (lifespan de src/api.py).
ENVIRONNEMENT=prod
# `false` OBLIGATOIRE en production (logs verbeux, docs exposables,
# tracebacks fournis). `true` uniquement en poste de développement.
DEBUG=false

# --- API — clés & RBAC ---
# Le serveur ne stocke JAMAIS de clé en clair : seulement des SHA-256, avec
# un rôle (user < validateur < admin). Gérer avec :
#   python3 scripts/gerer_cles.py generer --role admin --label operateur
#   python3 scripts/gerer_cles.py lister
#   python3 scripts/gerer_cles.py revoquer --label operateur
# Fichier des hashes (mode 0600, hors git) :
API_KEYS_FILE=data/api_keys.json
# Alternative : clés hachées via env, format `sha256hex:role:label` (virgules).
API_KEYS_HACHEES=
# [DÉPRÉCIÉ] Clés EN CLAIR dans l'env — tolérées en dev (rôle admin, warning),
# REFUSÉES si ENVIRONNEMENT=prod. Ne pas utiliser pour un nouveau déploiement.
API_KEY=
API_KEYS=
# Adresse d'écoute. 0.0.0.0 uniquement derrière un proxy TLS.
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1
# IP (ou CIDR) des proxys inverses de confiance, séparées par des virgules.
# SEULES ces IP voient X-Forwarded-For / X-Real-IP / X-Forwarded-Proto pris
# en compte (IP client réelle pour le rate-limit et les logs, schéma pour
# la redirection HTTPS). Vide = ces en-têtes sont toujours ignorés.
TRUSTED_PROXIES=
# Redirige http -> https (308), sauf /health. À activer derrière un
# terminateur TLS qui pose X-Forwarded-Proto.
FORCER_HTTPS=false
# Origines navigateur autorisées (séparées par des virgules).
# Un navigateur envoie `Origin: http(s)://host:port` (avec port) — chaque
# combinaison hôte:port doit être listée explicitement, la comparaison est
# exacte. En prod : restreindre au(x) vrai(s) domaine(s).
#
# SI LE SITE EST SERVI AUTREMENT QUE PAR L'ADRESSE LOCALE — proxy inverse,
# tunnel SSH, Tailscale —, l'origine PUBLIQUE doit figurer ici, avec son
# schéma exact. Exemple pour un service exposé par Tailscale Serve :
#   CORS_ORIGINS=...,https://ma-machine.mon-tailnet.ts.net
# Sans cette entrée, le navigateur est refusé et le préflight répond 400,
# alors que l'API elle-même fonctionne : le symptôme est déroutant.
#
# Le joker `*` est refusé au démarrage : combiné au cookie de session, il
# autoriserait toute origine tierce à porter l'authentification.
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8000,http://127.0.0.1:8000
# Exposer /docs et /redoc (Swagger) : true/false
EXPOSER_DOCS=false
# Taille max du corps de requête en octets (2 Mo)
TAILLE_MAX_REQUETE_OCTETS=2097152
# Pipelines /ask simultanés max ; au-delà -> 503 immédiat (anti-accumulation
# de générations MLX abandonnées). 0 = pas de plafond.
ASK_MAX_CONCURRENT=2

# --- Rate limiting (par IP d'origine) ---
# 60/min : marge pour l'UI, bloque un attaquant en ~2 s. S'applique à tous
# les endpoints sauf /health et l'interface web.
RATE_LIMIT_MAX_REQUETES=60
RATE_LIMIT_FENETRE_SECONDES=60
REDIS_RATE_LIMIT_MAX_REQUESTS=60
REDIS_RATE_LIMIT_WINDOW_SECONDS=60

# --- Embedding ---
# Modèle d'embedding des requêtes/chunks. DOIT produire la même dimension
# que la collection Qdrant (EMBEDDING_DIMENSION == QDRANT_VECTEUR_TAILLE),
# sinon toute recherche échoue silencieusement (0 evidence, réponses non
# ancrées). Le boot refuse un écart de dimension.
#
# `models/bge-m3-mlx` : copie LOCALE de BAAI/bge-m3 convertie pour
#   `mlx-embeddings` (1024-dim). Voie retenue : chargement ET encodage sur le
#   même thread (cf. src/mlx_embedding.py), condition pour que MLX accepte le
#   stream GPU.
#   À éviter : `BAAI/bge-m3` (dépôt HF sans safetensors, inutilisable par
#   mlx_embeddings) et `sentence-transformers/BAAI/bge-m3` (ancienne voie).
MODELE_EMBEDDING=models/bge-m3-mlx
EMBEDDING_DIMENSION=1024

# --- Modèles de génération ---
# Il n'y a qu'UN SEUL Mistral dans le système : MODELE_CITATION. Le Retriever
# n'utilise AUCUN LLM (il n'emploie que le modèle d'embedding ci-dessus) — la
# ligne « Retriever = Mistral 7B » de l'ancienne documentation était fausse.
# Une question type charge deux 7B (Qwen pour Temporal/Explainer, Mistral pour
# Citation) ; DeepSeek-R1 14B ne sert qu'à l'agent Conflit.
MODELE_TEMPORAL=mlx-community/Qwen2.5-7B-Instruct-4bit
MODELE_EXPLAINER=mlx-community/Qwen2.5-7B-Instruct-4bit
MODELE_CITATION=mlx-community/Mistral-7B-Instruct-v0.3-4bit
MODELE_CONFLIT=mlx-community/DeepSeek-R1-Distill-Qwen-14B-4bit

# Modèles de génération gardés en mémoire : 2 = les deux 7B d'une même question
# (Qwen + Mistral), ce qui évite tout swap en régime normal. Baisser à 1 sur une
# machine à 16 Go. Le quota d'évictions protège des bascules en rafale.
# MLX_MODELES_RESIDENTS_MAX=2
# MLX_MAX_SWAPS_PAR_MINUTE=3

# --- Qdrant ---
# Hôte local par défaut. Adapter à l'infra (ne PAS committer d'IP interne).
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_HTTPS=false
QDRANT_API_KEY=
# Taille des vecteurs de la collection — doit égaler EMBEDDING_DIMENSION.
QDRANT_VECTEUR_TAILLE=1024

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- PostgreSQL (audit, Mac C) — jamais de mot de passe en dur dans le code ---
POSTGRES_DSN=

# --- Mode orchestrateur : real ou mock ---
# ORCHESTRATEUR_MODE=real

# --- Watcher ---
# WATCHER_INTERVALLE_HEURES=6
# WATCHER_FOLLOW_REDIRECTS=false
# Désactiver quand le Watcher tourne dans un process séparé (gunicorn
# multi-worker, systemd unit dédiée) pour éviter les cycles concurrents.
# WATCHER_ACTIF=true
# Délai (s) après le boot avant le premier cycle — laisse /health répondre.
# WATCHER_DELAI_DEMARRAGE_SECONDES=30

# --- Audit ---
# AUDIT_LOCAL_PATH=data/audit.jsonl
